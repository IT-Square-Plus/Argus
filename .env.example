# ============================================================================
# MCP Server Configuration
# ============================================================================
# Host and port for the MCP server (Docker container internal)
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8081

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================================================
# Brave Search API - Free Plan Limits
# ============================================================================
# These values define the monthly quota limits for each API plan.
# Used for usage tracking and quota display in logs.
# Default values match Brave's free tier limits (as of 2025).

# Data for Search Free Plan: 1 req/sec, 2000 req/month
DATA_FOR_SEARCH_FREE_PLAN_MAX_USAGE=2000

# Data for AI Free Plan: 1 req/sec, 2000 req/month
DATA_FOR_AI_FREE_PLAN_MAX_USAGE=2000

# Spellcheck Free Plan: 5 req/sec, 5000 req/month
DATA_FOR_SPELLCHECK_FREE_PLAN_MAX_USAGE=5000

# Autosuggest Free Plan: 5 req/sec, 5000 req/month
DATA_FOR_AUTOSUGGEST_FREE_PLAN_MAX_USAGE=5000

# ============================================================================
# API Key for Docker Container Startup (OPTIONAL)
# ============================================================================
# This key is used ONLY during container startup to check your current API usage
# and display accurate quota information in startup logs.
#
# IMPORTANT: Argus MCP tools will work WITHOUT this key!
# - Runtime API calls use keys from .mcp.json (via HTTP headers)
# - This .env key ONLY affects startup usage tracking display
# - If invalid/missing: startup shows 0/2000, but tools still work correctly
#
# Why separate from .mcp.json?
# - Docker container starts BEFORE any HTTP requests arrive
# - Initial usage check happens at startup (no .mcp.json headers available yet)
# - Runtime tools use .mcp.json keys (provided via HTTP headers per request)
#
# Recommendation: Use your "Data for Search" API key here for accurate startup stats
X_BRAVE_API_KEY_SEARCH=your_brave_search_api_key_here
